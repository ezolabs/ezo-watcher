    }
  ],
  "splitIncidents": [
    {
      "match": {
        "origin": "^api-uptime$"
      },
      "by": "instance"
    },
    {
      "match": {
        "origin": "^sentry$"
      },
      "by": "instance"
    },
    {
      "match": {
        "origin": "^gateway-runway$"
      },
      "by": "instance"
    }
  ],
  "inferredCellExclude": [
    {
      "origin": "^sweep$",
      "rule": "^BugFiled",
      "note": "Bug reports filed by people are not wanted on the wall: a finding of this class leaves no rule cell behind once it resolves."
    },
    {
      "origin": "^sweep$",
      "rule": "^GrafanaRule$",
      "note": "Watch reads Grafana itself: the sweep no longer pushes its GrafanaRule findings or lists them as a check, so a resolved one leaves no dotted cell on the Regression sweep tile."
    },
    {
      "rule": "^Zulip",
      "note": "Zulip is no longer used (the server went on 2026-10-15) and its alert rules are deleted, so a resolved Zulip alert (Zulip backup stale, the last one) leaves no dotted cell on the Chat tile for its 30 days of history."
    },
    {
      "rule": "(?:Test|^TestAlert)$",
      "note": "Wiring and smoke-test classes (ApiAlertTest, WatchWiringTest, ChatWiringTest, ChatCutoverDevTest, TestAlert) prove a path once; they are not rules, so a resolved one leaves no dotted cell."
    }
  ],
  "severityCaps": [
    {
      "match": {
        "origin": "^dev$"
      },
      "max": "warning",
      "note": "dev is the router's dev stack, and dev is never red on the wall: a dev outage caps at warning."
    },
    {
      "match": {
        "labels": {
          "namespace": "^(box|worker|web)-dev$"
        }
      },
      "max": "warning",
      "note": "A dev Kubernetes namespace (dev, box-dev, web-dev), and dev is never red on the wall."
    },
    {
      "match": {
        "labels": {
          "env": "^((box|worker|web)-)?dev$"
        }
      },
      "max": "warning",
      "note": "The alert names a dev environment in its env label, and dev is never red on the wall."
    },
    {
      "match": {
        "labels": {
          "backend": "-dev$"
        }
      },
      "max": "warning",
      "note": "A dev router backend (web-2-dev, worker-2-dev), and dev is never red on the wall."
    },
    {
      "match": {
        "origin": "^sweep$",
        "rule": "^Prober(TargetDown|StateStale)$",
        "labels": {
          "service": "(^|-)(dev|sandbox)(-|$)"
        }
      },
      "max": "warning",
      "note": "An node-2 prober target of a dev or sandbox stack (gag-core-dev-cloudflared, gag-core-sandbox-cloudflared), and dev is never red on the wall."
    },
    {
      "match": {
        "origin": "^api-uptime$",
        "labels": {
          "instance": "(^|-)(dev|sandbox)(-|$)"
        }
      },
      "max": "warning",
      "note": "An node-2 prober target of a dev or sandbox stack (router-dev-healthz, gag-core-dev-postgres), and dev is never red on the wall."
    }
  ],
  "wallGroups": [
    {
      "id": "product",
      "label": "Product",
      "services": [
        "API",
        "API edge",
        "API router",
        "Acme desktop",
        "Acme helper",
        "Acme mobile",
        "Acme web",
        "Edge",
        "Router",
        "Helper",
        "desktop app",
        "mobile app",
        "Docs",
        "prod/docs",
        "prod/scraper",
        "Chat",
        "Client link"
      ]
    },
    {
      "id": "notifications",
      "label": "API router",
      "services": [
        "API notifications"
      ]
    },
    {
      "id": "reliability",
      "label": "Reliability signals",
      "services": [
        "Ops errors",
        "Ops slo",
        "Ops latency",
        "Ops traffic",
        "Ops turns",
        "Error clusters",
        "Error breadth",
        "New errors",
        "Regression sweep"
      ]
    },
    {
      "id": "infrastructure",
      "label": "Infrastructure",
      "services": [
        "Host disks",
        "Node disk",
        "Fleet load",
        "Netdata",
        "ClickHouse",
        "Postgres",
        "Backups",
        "Metrics store",
        "Metrics pipeline",
        "Ingest",
        "Gateway",
        "Alert pipeline",
        "Cloud computers",
        "Watch sources",
        "Watch self-test"
      ]
    },
    {
      "id": "external",
      "label": "External and vendors",
      "services": [
        "Gateway gateway",
        "Egress gateway",
        "Vendors and billing",
        "Uptime"
      ]
    }
  ],
  "channels": [
    {
      "id": "ntfy",
      "type": "ntfy",
      "server": "https://ntfy.sh",
      "topicEnv": "NTFY_TOPIC",
      "tokenEnv": "NTFY_TOKEN",
      "self": {
        "urlEnv": "NTFY_SELF_URL",
        "topicEnv": "NTFY_SELF_TOPIC",
        "tokenEnv": "NTFY_SELF_TOKEN"
      },
      "primaryEnv": "NTFY_PRIMARY"
    },
    {
      "id": "webpush",
      "type": "webpush",
      "publicKeyEnv": "WEBPUSH_PUBLIC_KEY",
      "privateKeyEnv": "WEBPUSH_PRIVATE_KEY",
      "subject": "mailto:you@example.com"
    },
    {
      "id": "sms-telnyx",
      "type": "sms",
      "provider": "telnyx",
      "apiKeyEnv": "TELNYX_API_KEY",
      "fromEnv": "TELNYX_FROM",
      "toEnv": "WATCH_SMS_TO"
    },
    {
      "id": "email",
      "type": "email",
      "provider": "resend",
      "apiKeyEnv": "RESEND_API_KEY",
      "from": "EZO Watcher <watch@alerts.example.com>",
      "toEnv": "WATCH_EMAIL_TO"
    },
    {
      "id": "hook",
      "type": "webhook",
      "urlEnv": "WATCHER_WEBHOOK_URL"
    }
  ],
  "routes": [
    {
      "id": "dev-wall-only",
      "match": {
        "origin": [
          "dev"
        ]
      },
      "receivers": [],
      "mode": "all",
      "groupWaitSec": 0,
      "groupIntervalSec": 300,
      "repeatIntervalSec": 86400
    },
    {
      "id": "netdata-unreachable",
      "match": {
        "severity": [
          "page"
        ],
        "origin": [
          "netdata",
          "netdata-cloud"
        ],
        "labels": {
          "alertname": "NetdataNodeUnreachable"
        }
      },
      "receivers": [
        "ntfy",
        "webpush"
      ],
      "mode": "ladder",
      "record": [],
      "groupWaitSec": 180,
      "groupIntervalSec": 120,
      "repeatIntervalSec": 1800,
      "coalesce": {
        "maxPages": 10,
        "windowSec": 600
      },
      "escalate": [
        {
          "afterSec": 600,
          "receivers": [
            "sms-telnyx"
          ]
        },
        {
          "afterSec": 3600,
          "receivers": [
            "email"
          ]
        }
      ],
      "sendResolved": true
    },
    {
      "id": "page",
      "match": {
        "severity": [
          "page"
        ]
      },
      "receivers": [
        "ntfy",
        "webpush"
      ],
      "mode": "ladder",
      "record": [],
      "groupWaitSec": 0,
      "groupIntervalSec": 120,
      "repeatIntervalSec": 1800,
      "coalesce": {
        "maxPages": 10,
        "windowSec": 600
      },
      "escalate": [
        {
          "afterSec": 600,
          "receivers": [
            "sms-telnyx"
          ]
        },
        {
          "afterSec": 3600,
          "receivers": [
            "email"
          ]
        }
      ],
      "sendResolved": true
    },
    {
      "id": "sweep-wall-only",
      "match": {
        "severity": [
          "warning"
        ],
        "origin": [
          "sweep"
        ]
      },
      "receivers": [],
      "mode": "all",
      "groupWaitSec": 0,
      "groupIntervalSec": 300,
      "repeatIntervalSec": 86400
    },
    {
      "id": "warning",
      "match": {
        "severity": [
          "warning"
        ]
      },
      "receivers": [
        "hook"
      ],
      "mode": "all",
      "groupWaitSec": 60,
      "groupIntervalSec": 300,
      "repeatIntervalSec": 86400,
      "sendResolved": true
    }
  ],
  "quietHours": {
    "tz": "America/Chicago",
    "start": "22:00",
    "end": "07:00"
  }
}