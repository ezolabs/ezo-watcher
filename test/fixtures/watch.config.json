    },
    {
      "match": {
        "labels": {
          "component": "^gateway$"
        }
      },
      "service": "Gateway"
    },
    {
      "match": {
        "labels": {
          "component": "^router$"
        }
      },
      "service": "Router"
    },
    {
      "match": {
        "labels": {
          "component": "^client-link$"
        }
      },
