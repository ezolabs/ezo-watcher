{
  "baseUrl": "https://watch.example.com",
  "dataDir": "/data",
  "historyHours": 24,
  "staleAfterMisses": 3,
  "sources": [
    {
      "id": "grafana",
      "type": "grafana",
      "url": "http://192.0.2.10:3000",
      "publicUrl": "https://grafana.example.com",
      "tokenEnv": "GRAFANA_TOKEN",
      "pollSec": 10
    },
    {
      "id": "netdata-cloud",
      "type": "netdata-cloud",
      "url": "https://app.netdata.cloud",
      "tokenEnv": "NETDATA_CLOUD_TOKEN",
      "spaceId": "00000000-0000-4000-8000-00000000000f",
      "roomId": "00000000-0000-4000-8000-000000000010",
      "pollSec": 60,
      "fleetNodes": [
        "node-1",
        "node-2",
        "node-3",
        "node-4",
        "node-5",
        "node-6",
        "node-7",
        "node-8",
        "node-13",
        "node-14",
        "node-15"
      ],
      "watchOnlyNodes": [
        "mac-a1.example.net"
      ],
      "ignoreNodes": {
        "print": "print spooler, not monitored"
      },
      "ignoreInstances": [
        {
          "node": "^node-5$",
          "instance": "^mem\\.swap$",
          "note": "node-5 has 8 GB of swap on a 190 GB box, so Netdata's used_swap (share of swap used, warns above 90 %) fills whenever a ClickHouse scan pushes idle primary-pg pages out and then never clears: nothing faults them back. It says nothing about pressure (2026-10-17: swap 94.5 % used, MemAvailable 93 %, no swap I/O, no OOM kill). Low MemAvailable still raises through ram_available, ram_in_use, HostMemoryHot and oom_kill."
        }
      ],
      "quietAlerts": [
        "10min_disk_backlog",
        "10min_disk_utilization",
        "10min_cpu_iowait",
        "20min_steal_cpu"
      ],
      "diskWarningFloor": {
        "usedPct": 80,
        "note": "No disk warning while a disk is under 80 % used; a disk projected full in under 2 hours (Netdata's critical tier) still pages at any fill."
      },
      "cloudUrl": "https://app.netdata.cloud/spaces/example-space/rooms/all-nodes"
    },
    {
      "id": "netdata-fleet",
      "type": "netdata-fleet",
      "url": "https://app.netdata.cloud",
      "tokenEnv": "NETDATA_CLOUD_TOKEN",
      "spaceId": "00000000-0000-4000-8000-00000000000f",
      "roomId": "00000000-0000-4000-8000-000000000010",
      "pollSec": 60,
      "windowMin": 60,
      "cloudUrl": "https://app.netdata.cloud/spaces/example-space/rooms/all-nodes",
      "fleetNodes": [
        "node-1",
        "node-2",
        "node-3",
        "node-4",
        "node-5",
        "node-6",
        "node-7",
        "node-8",
        "node-13",
        "node-14",
        "node-15"
      ],
      "watchOnlyNodes": [
        "mac-a1.example.net"
      ],
      "ignoreNodes": {
        "print": "print spooler, not monitored"
      },
      "k8sNodes": [
        "netdata-k8s-state"
      ],
      "rules": {
        "cpu": {
          "warnAbove": 80,
          "clearBelow": 70,
          "forMin": 10
        },
        "memory": {
          "warnAbove": 85,
          "clearBelow": 80,
          "pageAbove": 95,
          "pageClearBelow": 90,
          "forMin": 10
        },
        "load": {
          "warnAbove": 1.5,
          "clearBelow": 1.2,
          "forMin": 15
        },
        "coldCpuBelow": 10
      }
    },
    {
      "id": "vmalert",
      "type": "vmalert",
      "url": "http://127.0.0.1:8428",
      "pollSec": 30
    },
    {
      "id": "sentry",
      "type": "sentry",
      "url": "https://us.sentry.io",
      "webUrl": "https://example.sentry.io",
      "org": "example-org",
      "tokenEnv": "SENTRY_READ_TOKEN",
      "pollSec": 120,
      "projects": {
        "acme-desktop": "Acme desktop",
        "acme-mobile": "Acme mobile",
        "acme-helper": "Acme helper",
        "acme-web": "Acme web"
      },
      "environments": [
        "production",
        "testflight"
      ],
      "pageEnvironments": [
        "production"
      ]
    },
    {
      "id": "webhook",
      "type": "webhook",
      "tokenEnv": "INGEST_TOKEN"
    },
    {
      "id": "sweep",
      "type": "webhook",
      "tokenEnv": "INGEST_TOKEN",
      "staleAfterSec": 43200,
      "presenceTtlSec": 86400,
      "recheckRequests": {
        "pickupWithinSec": 90
      }
    },
    {
      "id": "webhook-push",
      "type": "webhook",
      "tokenEnv": "INGEST_TOKEN",
      "staleAfterSec": 3600,
      "presenceTtlSec": 3600,
      "recheckRequests": {
        "pickupWithinSec": 120
      }
    },
    {
      "id": "netdata",
      "type": "webhook",
      "tokenEnv": "NETDATA_INGEST_TOKEN",
      "presenceTtlSec": 259200
    },
    {
      "id": "feed",
      "type": "feed",
      "url": "http://127.0.0.1:9100/alerts",
      "tokenEnv": "FEED_TOKEN",
      "pollSec": 60
    },
    {
      "id": "ports",
      "type": "tcp-probe",
      "pollSec": 60,
      "targets": [
        {
          "id": "postgres-port",
          "service": "Postgres",
          "host": "127.0.0.1",
          "port": 5432,
          "slowMs": 250,
          "failAfter": 3
        }
      ]
    },
    {
      "id": "domains",
      "type": "domain-expiry",
      "service": "Gateway",
      "pollSec": 43200,
      "warnDays": 30,
      "pageDays": 7,
      "domains": [
        "example.com"
      ]
    },
    {
      "id": "nightly-sweep",
      "type": "heartbeat",
      "name": "nightly sweep",
      "every": "1d",
      "grace": "5m",
      "tokenEnv": "HEARTBEAT_SWEEP_TOKEN",
      "service": "Regression sweep"
    },
    {
      "id": "host",
      "type": "host",
      "pollSec": 60,
      "mounts": [
        "/",
        "/data"
      ],
      "pidFile": "/run/example-app.pid",
      "thresholds": {
        "diskFreeWarnPct": 10,
        "diskFreePagePct": 5,
        "memAvailableWarnPct": 10,
        "loadPerCoreWarn": 2
      }
    }
  ],
  "serviceMap": [
    {
      "match": {
        "labels": {
          "component": "^edge"
        }
      },
      "service": "API edge"
    },
    {
      "match": {
        "labels": {
          "component": "^clickhouse"
        }
      },
      "service": "ClickHouse"
    },
    {
      "match": {
        "origin": "^sweep$",
        "rule": "^IntakeSink"
      },
      "service": "ClickHouse"
    },
    {
      "match": {
        "origin": "^sweep$",
        "labels": {
          "service": "^[Cc]lick[Hh]ouse$"
        }
      },
      "service": "ClickHouse"
    },
    {
      "match": {
        "labels": {
          "component": "^(vendor|billing)"
        }
      },
      "service": "Vendors and billing"
    },
    {
      "match": {
        "labels": {
          "component": "^cloud-computer"
        }
      },
      "service": "Cloud computers"
    },
    {
      "match": {
        "rule": "^(Api|R14)"
      },
      "service": "API router"
    },
    {
      "match": {
        "rule": "^(Chat|Notifications|Wiring)"
      },
      "service": "Chat"
    },
    {
      "match": {
        "rule": "^TestAlert$"
      },
      "service": "Alert pipeline"
    },
    {
      "match": {
        "labels": {
          "component": "^alert-pipeline"
        }
      },
      "service": "Alert pipeline"
    },
    {
      "match": {
        "labels": {
          "component": "^host-disk"
        }
      },
      "service": "Host disks"
    },
    {
      "match": {
        "labels": {
          "component": "^node-disk"
        }
      },
      "service": "Node disk"
    },
    {
      "match": {
        "labels": {
          "component": "^gateway"
        }
      },
      "service": "Gateway gateway"
    },
    {
      "match": {
        "labels": {
          "component": "^metrics-pipeline"
        }
      },
      "service": "Metrics pipeline"
    },
    {
      "match": {
        "labels": {
          "component": "^metrics-store"
        }
      },
      "service": "Metrics store"
    },
    {
      "match": {
        "labels": {
          "component": "^backups"
        }
      },
      "service": "Backups"
    },
    {
      "match": {
        "labels": {
          "component": "^ingest"
        }
      },
      "service": "Ingest"
    },
    {
      "match": {
        "labels": {
          "component": "^postgres"
        }
      },
      "service": "Postgres"
    },
    {
      "match": {
        "labels": {
          "component": "^clickhouse-health"
        }
      },
      "service": "ClickHouse"
    },
    {
      "match": {
        "origin": "^netdata$"
      },
      "service": "Netdata"
    },
    {
      "match": {
        "origin": "^vmalert$"
      },
      "service": "API router"
    },
    {
      "match": {
        "origin": "^api-"
      },
      "service": "API router"
    },
    {
      "match": {
        "labels": {
          "component": "^error-clusters$"
        }
      },
      "service": "Error clusters"
    },
    {
      "match": {
        "labels": {
          "component": "^error-breadth$"
        }
      },
      "service": "Error breadth"
    },
    {
      "match": {
        "labels": {
          "component": "^ops-slo$"
        }
      },
      "service": "Ops slo"
    },
    {
      "match": {
        "labels": {
          "component": "^ops-errors$"
        }
      },
      "service": "Ops errors"
    },
    {
      "match": {
        "labels": {
          "component": "^ops-latency$"
        }
      },
      "service": "Ops latency"
    },
    {
      "match": {
        "labels": {
          "component": "^ops-traffic$"
        }
      },
      "service": "Ops traffic"
    },
    {
      "match": {
        "labels": {
          "component": "^ops-turns$"
        }
      },
